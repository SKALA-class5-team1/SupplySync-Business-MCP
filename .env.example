DB_HOST=localhost
DB_PORT=5432
DB_NAME=supplysync
DB_SCHEMA=public
# 원격 DB(Supabase 등)는 require. 로컬 SSL 없는 DB는 prefer 또는 disable
DB_SSLMODE=require
# SELECT 권한만 가진 계정을 사용합니다.
# 조회 전용 계정. Supabase pooler는 business_mcp_user.<project_ref> 형식
DB_USER=business_mcp_user
DB_PASSWORD=
# 내부 호출 공용 키: AI → 이 서버 요청 검사, 이 서버 → 백엔드 요청 헤더에 모두 쓴다
INTERNAL_API_KEY=
# 다른 호스트에서 접속해야 하면 수신 주소를 변경합니다.
SERVER_ADDRESS=127.0.0.1
# 백엔드 API Tool(쓰기 3개 + RFQ 원문 조회)이 호출할 Spring 백엔드 (/internal/**)
BACKEND_URL=http://localhost:8080
